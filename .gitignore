后端/src/front/node_modules
1.资料

# ==========================================
# 1. Python 核心与字节码
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# 2. 分发与打包
# ==========================================
dist/
build/
*.egg-info/
*.egg
.eggs/
*.whl

# ==========================================
# 3. 虚拟环境 (根据你使用的工具三选一即可，这里全屏蔽)
# ==========================================
# 标准库 venv
venv/
.venv/
env/
ENV/

# Conda 环境
.conda/

# Poetry
# poetry.lock 通常建议提交，但如果只是应用而非库，可以忽略
# poetry.lock

# Pipenv
Pipfile.lock

# ==========================================
# 4. 测试与代码覆盖率
# ==========================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# ==========================================
# 5. 类型检查与代码规范
# ==========================================
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.ruff_cache/

# ==========================================
# 6. Jupyter Notebook (如果涉及数据分析)
# ==========================================
.ipynb_checkpoints

# ==========================================
# 7. 环境变量与密钥 (非常重要！防止泄露密码和密钥)
# ==========================================
.env
.env.local
.env.*.local
*.pem
*.key

# ==========================================
# 8. IDE 与编辑器配置
# ==========================================
# VS Code
.vscode/
# 仅忽略工作区设置，保留推荐扩展（如果你想保留.vscode/extensions.json可取消下面注释）
# !.vscode/extensions.json
# !.vscode/settings.json

# PyCharm
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ==========================================
# 9. 操作系统生成的杂项文件
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ==========================================
# 10. 日志与数据库本地文件
# ==========================================
*.log
logs/
*.sql
*.sqlite3
db.sqlite3

# ==========================================
# 11. 媒体与静态文件 (如果是 Web 后端项目，通常不提交用户上传的文件)
# ==========================================
# Django / FastAPI / Flask 常见
media/
uploads/
# staticfiles/ (通常静态资源是由前端或CDN管理，如果是后端生成的可忽略)
