# Windows API 访问 WSL 基础设施时优先尝试 localhost，按实际映射修改。
# 在 WSL 运行时需重新 uv sync，不能复用 Windows 的 .venv。
MEDICAL_HOST=127.0.0.1
MEDICAL_PORT=8000
MEDICAL_RELOAD=false
LOG_LEVEL=DEBUG
LOG_COLOR=auto
MEDICAL_MONGO_URI=mongodb://localhost:27017
MEDICAL_MONGO_DATABASE=medical_consultation
MEDICAL_WORKER_CONCURRENCY=2
MEDICAL_WORKER_POLL_SECONDS=1
MEDICAL_WORKER_LEASE_SECONDS=60
MEDICAL_WORKER_HEARTBEAT_SECONDS=15
MEDICAL_WORKER_SHUTDOWN_SECONDS=10
# 以下仅预留配置，尚未加载 SDK、访问服务或加载模型。
MEDICAL_MILVUS_URI=http://localhost:19530
MEDICAL_MINIO_ENDPOINT=localhost:9000
MEDICAL_MINIO_ACCESS_KEY=
MEDICAL_MINIO_SECRET_KEY=
MEDICAL_DEEPSEEK_BASE_URL=https://api.deepseek.com
MEDICAL_DEEPSEEK_API_KEY=
MEDICAL_DEEPSEEK_MODEL=deepseek-chat
MEDICAL_EMBEDDING_MODEL_PATH=D:/ai_models/modelscope_cache/models/bge-m3
MEDICAL_RERANKER_MODEL_PATH=
# MinerU 云端解析；不配置输出目录时使用后端/data/mineru。
MINERU_API_KEY=
MINERU_OUTPUT_DIR=
